{
  "name": "lineage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:extension": "esbuild vscode/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=vscode/out/extension.js",
    "build:vscode": "npm run build:webview && npm run build:extension",
    "test:vscode": "npm run build:vscode && esbuild vscode/test/suite.ts --bundle --platform=node --format=cjs --external:vscode --outfile=vscode/out/test/suite.js && node vscode/test/run.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
